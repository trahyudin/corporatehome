# ==========================================================
# KORPORA WEB ATELIER — ENVIRONMENT VARIABLES
# Copy this file to .env on your server or cPanel if using MySQL.
# If left empty, the API will automatically use SQLite without errors.
# ==========================================================

# Database Type: 'mysql' or 'sqlite'
DB_TYPE=mysql

# MySQL Settings (from cPanel MySQL Database Wizard)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=korpora_db
DB_USER=korpora_user
DB_PASS=YourStrongPasswordHere

# API Base URL (Frontend)
# In production on cPanel, leave as /api or your domain:
VITE_API_BASE_URL=/api
